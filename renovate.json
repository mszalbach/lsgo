{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Use test semantic commit type for e2e dependencies",
      "matchFileNames": [
        "e2e/go.mod"
      ],
      "commitMessagePrefix": "test(deps):"
    }
  ],
  "automerge": true
}