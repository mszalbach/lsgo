{{define "base"}}
<!doctype html>
<html lang='en'>
  <head>
    <meta charset='utf-8'>
    <title>{{template "page:title" .}} LSGo</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{.BaseURL}}/static/css/water.light.min.css">
    <link rel="stylesheet" href="{{.BaseURL}}/static/css/water.dark.min.css" media="(prefers-color-scheme: dark)">
    <link rel="stylesheet" href="{{.BaseURL}}/static/css/ls.css">
    <script src="{{.BaseURL}}/static/js/sort.js" defer></script>
    <script src="{{.BaseURL}}/static/js/selection.js" defer></script>
  </head>
  <body>
    <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol>
            {{range .Breadcrumb}}
            <li><a href="{{$.BaseURL}}/files/{{.RelPath.URLPath}}">{{.Name}}</a></li>
            {{end}}
        </ol>
    </nav>
    <main>
        {{template "page:content" .}}
    </main>
  </body>
</html>
{{end}}